{
  "name": "CleanWeb",
  "description": "Filter images, videos, iframes, and background media with clean, temporary browsing controls.",
  "version": "4.0.0",
  "permissions": ["storage", "activeTab", "alarms"],
  "action": {
    "default_title": "CleanWeb",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/img/icon16.png",
    "48": "assets/img/icon48.png",
    "128": "assets/img/icon128.png"
  },
  "commands": {
    "pause_5min": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "MacCtrl+P"
      },
      "description": "Pause CleanWeb for 60 seconds"
    },
    "toggle_whitelist": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "MacCtrl+W"
      },
      "description": "Allow or protect current site"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tab.js"],
      "run_at": "document_start"
    }
  ],
  "manifest_version": 3
}
